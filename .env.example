# Postgres / PostGIS analytics database
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=vob
DB_USER=postgres
DB_PASSWORD=pass
DB_SCHEMA=hgis
DB_READ_ONLY=true

# OpenAI-compatible LLM endpoint
# Leave these blank and run `vobchat setup-llm` if you want guided setup.
LLM_PROVIDER=openai-compatible
LLM_OPENAI_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_VERIFY_SSL=true

# Optional vLLM helper asset
VLLM_MODEL_REPOSITORY=Qwen/Qwen2.5-7B-Instruct
VLLM_PORT=8001
HF_TOKEN=

# Dash web service
DASH_DEBUG=true
DASH_URL_BASE_PATHNAME=/

# Auth and internal web -> API wiring
SECRET_KEY=dev-secret-key
AUTH_DATABASE_URL=sqlite:////app/data/users.db
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
WTF_CSRF_ENABLED=true
VOBCHAT_API_BASE_URL=http://api:8000

# Logging
VOBCHAT_LOG_LEVEL=INFO
VOBCHAT_LLM_LOG_LEVEL=INFO
