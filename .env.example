# Postgres / PostGIS analytics database
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=vob
DB_USER=postgres
DB_PASSWORD=pass
DB_SCHEMA=hgis
DB_READ_ONLY=true

# OpenAI-compatible local model endpoint (Ollama by default)
VOBCHAT_LLM_MODEL=hf.co/unsloth/Qwen3-30B-A3B-Thinking-2507-GGUF:Q4_K_M
VOBCHAT_LLM_TEMP=0.7
VOBCHAT_OLLAMA_REASONING=true
VOBCHAT_OPENAI_API_KEY=ollama
VOBCHAT_LLM_TIMEOUT_SECONDS=60
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434
OLLAMA_SUBPATH=
OLLAMA_USE_SSL=false

# Dash web service
DASH_DEBUG=true
DASH_URL_BASE_PATHNAME=/

# Auth and internal web -> API wiring
SECRET_KEY=dev-secret-key
AUTH_DATABASE_URL=sqlite:////app/data/users.db
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
WTF_CSRF_ENABLED=true
VOBCHAT_API_BASE_URL=http://api:8000

# Logging
VOBCHAT_LOG_LEVEL=INFO
VOBCHAT_LLM_LOG_LEVEL=INFO
